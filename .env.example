# Development-only example. NEVER commit real credentials or use this as production values.
# AadiTech OS Phase 1W: production startup requires an independently verified HTTPS
# reverse proxy, tightly allowlisted ingress, MFA policy and validated DB TLS.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
# GEMINI_MODEL=gemini-2.5-flash # optional; draft text only, never financial evidence

# Production-only settings (configure in secret/hosting manager, not from this example):
# NODE_ENV=production
# APP_URL=https://staging.example.invalid
# APP_REQUIRE_HTTPS=true
# APP_TRUSTED_PROXY_CIDRS=127.0.0.1/32
# APP_BIND_HOST=127.0.0.1
# APP_ALLOW_PUBLIC_BIND=true  # DO NOT USE without documented firewall/network isolation
# MFA_REQUIRE_PRIVILEGED=true
# MFA_ENCRYPTION_KEY=<64 random hexadecimal digits, securely backed up>

# Disposable local MySQL only; production MUST use DB_SSL=true with valid server trust.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=local_development_user
DB_PASSWORD=replace_with_local_nonproduction_secret
DB_NAME=aaditech_local
DB_SSL=false
# DB_SSL_CA_BASE64=<base64-encoded trusted MySQL CA PEM bundle when required>

# Optional AI features are separately permission-gated.
# GEMINI_API_KEY=<read from secret manager only>
# TELEGRAM_BOT_TOKEN=<not used for customer sending; keep disabled>
# TELEGRAM_ADMIN_CHAT_ID=<not used for customer sending; keep disabled>

# Owner bootstrap only after isolated migration and independent approval.
# AADITECH_OWNER_EMAIL=owner@example.invalid
# AADITECH_OWNER_NAME=Business Owner
# AADITECH_OWNER_PASSWORD=<unique secret supplied through protected environment>
