{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "db:migrate:auth": "tsx scripts/migrate-auth.ts",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "db:migrate:crm": "tsx scripts/migrate-crm.ts",
    "test:mysql": "tsx --test tests/crm-mysql.integration.ts",
    "db:migrate:quotes": "tsx scripts/migrate-quotes.ts",
    "db:migrate:quote-idempotency": "tsx scripts/migrate-quote-idempotency.ts",
    "db:migrate:quote-revisions": "tsx scripts/migrate-quote-revisions.ts",
    "db:migrate:quote-reviews": "tsx scripts/migrate-quote-reviews.ts",
    "db:migrate:release-holds": "tsx scripts/migrate-release-holds.ts",
    "db:migrate:reviewer-roles": "tsx scripts/migrate-reviewer-roles.ts",
    "reviewer:provision": "tsx scripts/provision-reviewer.ts",
    "db:migrate:security-events": "tsx scripts/migrate-security-events.ts",
    "db:migrate:login-security": "tsx scripts/migrate-login-security.ts",
    "db:migrate:mfa": "tsx scripts/migrate-mfa.ts",
    "db:migrate:mfa-audit": "tsx scripts/migrate-mfa-audit.ts",
    "db:migrate:mfa-recovery": "tsx scripts/migrate-mfa-recovery.ts",
    "staging:preflight": "tsx scripts/staging-preflight.ts",
    "test:auth-smoke": "tsx --test tests/auth-http-smoke.integration.ts",
    "auth:retention": "tsx scripts/auth-retention.ts",
    "test:retention-mysql": "tsx --test tests/auth-retention-mysql.integration.ts",
    "deployment:preflight": "tsx scripts/deployment-preflight.ts",
    "staging:https-probe": "tsx scripts/staging-https-probe.ts",
    "staging:acceptance-review": "tsx scripts/review-staging-acceptance.ts",
    "test:staging-security": "tsx --test tests/staging-https-probe.test.ts tests/staging-acceptance.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "6.4.5",
    "@types/express": "^4.17.21"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2"
  }
}
